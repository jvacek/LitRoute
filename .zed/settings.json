{
  "languages": {
    "Python": {
      "language_servers": ["pyrefly", "!pyright", "!pylsp", "ruff"]
    }
  },
  "lsp": {
    "pyrefly": {
      "binary": {
        "path": ".venv/bin/pyrefly",
        "arguments": ["lsp"]
      },
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python"
        },
        "pyrefly": {
          "project_includes": ["src/**/*.py", "tests/**/*.py"],
          "project_excludes": ["**/.[!/.]*", "**/*venv/**"],
          "search_path": ["src"],
          "ignore_errors_in_generated_code": true
        }
      }
    }
  },
  "file_types": {
    "Django": ["**/templates/**/*.html"]
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    ".ipython",
    ".pytest_cache",
    "node_modules",
    "__pycache__",
    ".webpack_cache",
    ".venv",
    ".ruff_cache",
    ".vscode"
  ]
}
