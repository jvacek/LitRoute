{
  "name": "flamerelay",
  "version": "0.1.0",
  "devDependencies": {
    "@babel/core": "^7.16.5",
    "@babel/preset-env": "^7.16.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@sentry/webpack-plugin": "^5.3.0",
    "@size-limit/file": "^12.1.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "babel-jest": "^30.3.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "mini-css-extract-plugin": "^2.4.5",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "webpack": "^5.82.0",
    "webpack-bundle-tracker": "^3.0.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.0.2",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": "24.14"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "browserslist": [
    "last 2 versions"
  ],
  "babel": {
    "presets": [
      "@babel/preset-env",
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ],
      "@babel/preset-typescript"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/flamerelay/static/js"
    ],
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/flamerelay/static/js/jest.setup.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "scripts": {
    "dev": "webpack serve --config webpack/dev.config.js",
    "build": "webpack --config webpack/prod.config.js",
    "lint": "eslint --max-warnings 0 flamerelay/static/js/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "size": "size-limit",
    "gen:api": "openapi-typescript openapi.yaml -o flamerelay/static/js/api/schema.d.ts"
  },
  "size-limit": [
    {
      "name": "entry (project + initial vendors, brotli)",
      "path": [
        "flamerelay/static/webpack_bundles/js/project-*.js",
        "flamerelay/static/webpack_bundles/js/vendor-react-*.js",
        "flamerelay/static/webpack_bundles/js/vendor-i18n-*.js",
        "flamerelay/static/webpack_bundles/js/vendor-sentry-*.js"
      ],
      "limit": "200 KB"
    },
    {
      "name": "vendor-maplibre (lazy, Unit/Checkin, brotli)",
      "path": "flamerelay/static/webpack_bundles/js/vendor-maplibre-*.js",
      "limit": "280 KB"
    },
    {
      "name": "Unit route chunk (brotli)",
      "path": "flamerelay/static/webpack_bundles/js/pages-Unit-*.js",
      "limit": "15 KB"
    },
    {
      "name": "Login route chunk (brotli)",
      "path": "flamerelay/static/webpack_bundles/js/pages-Login-*.js",
      "limit": "15 KB"
    }
  ],
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@maptiler/client": "^3.0.2",
    "@marsidev/react-turnstile": "^1.1.0",
    "@sentry/react": "^10.53.1",
    "@simplewebauthn/browser": "^13.3.0",
    "cobe": "^2.0.1",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "maplibre-gl": "^5.24.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react-i18next": "^17.0.8",
    "react-map-gl": "^8.0.4",
    "react-router-dom": "^7.15.1"
  }
}
